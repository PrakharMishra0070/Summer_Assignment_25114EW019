// fibonaci sseries - the next number is sum of previous two numbers
// a , b , c where c is the sum of a and b 
// Note :- It starts with 0
#include <stdio.h>

int main() {
    int n, first = 0, second = 1, next, i;

    printf("Enter the number of terms: ");
    scanf("%d", &n);

    printf("Fibonacci Series: ");

    for(i = 1; i <= n; i++) {
        printf("%d ", first); 
        next = first + second;
        first = second;
        second = next;
    }

    return 0;
}